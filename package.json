{
    "name":  "persona-memory",
    "version":  "0.3.0",
    "description":  "Social state layer for conversational agents: decaying affinity, expiring tags, local style stats, budgeted prompt blocks. Zero LLM calls, zero deps. Memory for chatbots, AI companions, NPCs and customer support.",
    "type":  "module",
    "main":  "src/index.js",
    "exports":  {
                    ".":  "./src/index.js",
                    "./adapters/onebot":  "./adapters/onebot/index.js",
                    "./adapters/generic":  "./adapters/generic/index.js",
                    "./adapters/langchain":  "./adapters/langchain/index.js",
                    "./types":  "./index.d.ts"
                },
    "files":  [
                  "src",
                  "adapters",
                  "demo",
                  "examples",
                  "index.d.ts",
                  "README.md",
                  "NOTICE.md",
                  "LICENSE",
                  "!demo/.data"
              ],
    "keywords":  [
                     "agent-memory",
                     "persona",
                     "affinity",
                     "relationship",
                     "chatbot",
                     "llm",
                     "ai-companion",
                     "social-simulation",
                     "npc",
                     "user-profile",
                     "character-ai",
                     "memory"
                 ],
    "engines":  {
                    "node":  "\u003e=18"
                },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/suking459/persona-memory.git"
                   },
    "scripts":  {
                    "test":  "node --test test/core.test.mjs",
                    "demo":  "node demo/server.js",
                    "http":  "node adapters/http/server.js",
                    "mcp":  "node adapters/mcp/server.js"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "types":  "index.d.ts",
    "devDependencies":  {
                            "typescript":  "^5.9.3"
                        },
    "author":  "suking459",
    "contributors":  [
                         "Kondius (original memory-tree design in Kondius/qq-agent)"
                     ]
}
