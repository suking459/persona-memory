{
    "name":  "persona-memory",
    "version":  "0.1.0",
    "description":  "Social state layer for conversational agents: decaying affinity, expiring tags, local style stats, budgeted prompt blocks. Zero LLM calls, zero deps. Memory for chatbots, AI companions, NPCs and customer support.",
    "type":  "module",
    "main":  "src/index.js",
    "exports":  {
                    ".":  "./src/index.js",
                    "./adapters/onebot":  "./adapters/onebot/index.js",
                    "./adapters/generic":  "./adapters/generic/index.js"
                },
    "files":  [
                  "src",
                  "adapters",
                  "examples",
                  "README.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "agent-memory",
                     "persona",
                     "affinity",
                     "relationship",
                     "chatbot",
                     "llm",
                     "ai-companion",
                     "social-simulation",
                     "npc",
                     "user-profile",
                     "character-ai",
                     "memory"
                 ],
    "engines":  {
                    "node":  "\u003e=18"
                },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/suking459/persona-memory.git"
                   },
    "scripts":  {
                    "test":  "node --test test/core.test.mjs",
                    "mcp":  "node adapters/mcp/server.js",
                    "http":  "node adapters/http/server.js",
                    "example":  "node examples/basic.js"
                },
    "publishConfig":  {
                          "access":  "public"
                      }
}
