{
  "name": "independent-synthetic-long-term-v1",
  "provenance": "Written for persona-memory. Capability categories informed by cited papers; no paper prompts, benchmark conversations, answers or code copied.",
  "scenarios": [
    {"now":1000,"steps":[
      {"op":"propose","proposal":{"id":"candidate-language","memory":{"subject":{"type":"project","id":"alpha"},"kind":"preference","key":"documentation-language","value":"English","evidenceId":"session-1"}}},
      {"op":"check","name":"pending capture stays invisible","category":"capture-review","options":{"subject":{"type":"project","id":"alpha"},"query":"documentation"},"expected":[],"forbidden":["candidate-language"]},
      {"op":"accept","id":"candidate-language","as":"language"},
      {"op":"check","name":"reviewed capture is available","category":"capture-review","options":{"subject":{"type":"project","id":"alpha"},"query":"documentation"},"expected":["@language"]},
      {"op":"restart"},
      {"op":"check","name":"review survives a session restart","category":"persistence","options":{"subject":{"type":"project","id":"alpha"},"query":"documentation"},"expected":["@language"]},
      {"op":"put","record":{"id":"summary","subject":{"type":"project","id":"alpha"},"kind":"fact","key":"derived-summary","value":"The documentation language is English.","derivedFrom":[{"id":"@language","revision":1}]}},
      {"op":"time","now":2000},
      {"op":"put","record":{"id":"language-corrected","subject":{"type":"project","id":"alpha"},"kind":"preference","key":"documentation-language","value":"Spanish","replaceId":"@language"}},
      {"op":"check","name":"correction removes stale original and derivative","category":"knowledge-update","options":{"subject":{"type":"project","id":"alpha"},"query":"documentation"},"expected":["language-corrected"],"forbidden":["@language","summary"]},
      {"op":"restart"},
      {"op":"check","name":"invalidated summary stays unavailable after reload","category":"knowledge-update","options":{"subject":{"type":"project","id":"alpha"},"query":"derived-summary"},"expected":[],"forbidden":["summary"]}
    ]},
    {"now":1000,"steps":[
      {"op":"put","record":{"id":"owner","subject":{"type":"project","id":"alpha"},"kind":"fact","key":"release-owner","value":"Maya"}},
